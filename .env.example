PORT=3000
HOST=0.0.0.0

# Gemini API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemeini_api_key

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# PostgreSQL Database Supabase
DATABASE_URL=your_supabase_database

# WhatsApp Session Storage Directory
WA_SESSION_DIR=./sessions

# Google Calendar Oauth (Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Obsidian Vault
OBSIDIAN_VAULT_PATH=/your_obsidian_vault_path
OBSIDIAN_MEETING_FOLDER=your_folder_name

# Google Analytics (Get from https://analytics.google.com)
GA_PROPERTIES=propertyAlias:propertyID