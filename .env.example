PORT=3000
HOST=0.0.0.0

# Gemini API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemeini_api_key

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mikami_db

# WhatsApp Session Storage Directory
WA_SESSION_DIR=./sessions

# ── Google Calendar OAuth2 ──────────────────────────────────────
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Obsidian Vault ──────────────────────────────────────────────
# Full path to your Obsidian vault folder
OBSIDIAN_VAULT_PATH=/path/to/your/ObsidianVault
# Subfolder within vault where meeting notes are stored
OBSIDIAN_MEETING_FOLDER=Meetings
